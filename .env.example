# Video Platform - Environment Variables
# Copy this file to .env and customize for your environment
# NEVER commit .env to version control!

# ===========================================
# Database (PostgreSQL)
# ===========================================
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform_dev_password
POSTGRES_DB=video_platform

# ===========================================
# JWT Authentication
# ===========================================
# Generate a secure 256-bit (32-byte) secret for production:
# openssl rand -base64 32
JWT_SECRET=dev_secret_key_change_in_production_min_256_bits_abcdefghijklmnopqrstuvwx
JWT_ACCESS_TOKEN_EXPIRY_MS=900000          # 15 minutes
JWT_REFRESH_TOKEN_EXPIRY_MS=2592000000     # 30 days

# ===========================================
# MinIO / S3 Object Storage
# ===========================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET_VIDEOS=videos
MINIO_BUCKET_THUMBNAILS=thumbnails
MINIO_BUCKET_HLS=hls
MINIO_BUCKET_AVATARS=avatars
MINIO_BUCKET_BANNERS=banners

# For AWS S3 in production:
# S3_ENDPOINT=https://s3.region.amazonaws.com
# S3_REGION=us-east-1
# S3_ACCESS_KEY=your_access_key
# S3_SECRET_KEY=your_secret_key
# S3_BUCKET_VIDEOS=your-videos-bucket

# ===========================================
# Kafka
# ===========================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_PREFIX=video-platform

# ===========================================
# Redis
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=          # Empty for dev, set in production

# ===========================================
# Elasticsearch
# ===========================================
ELASTICSEARCH_HOST=http://localhost:9200
ELASTICSEARCH_USERNAME=  # Empty for dev (security disabled)
ELASTICSEARCH_PASSWORD=  # Empty for dev

# ===========================================
# Upload Configuration
# ===========================================
UPLOAD_CHUNK_SIZE_MB=256
UPLOAD_MAX_FILE_SIZE_GB=50
UPLOAD_TEMP_DIR=/tmp/uploads

# ===========================================
# Transcoding Configuration
# ===========================================
FFMPEG_THREADS=2
TRANSCODING_TEMP_DIR=/tmp/transcoding
TRANSCODING_HLS_SEGMENT_DURATION=6

# Resolution ladder (source resolution -> output resolutions)
# Format: "source_width:source_height=output1_width:output1_height,output2_width:output2_height..."
# Empty = use default ladder (no upscale)
TRANSCODING_RESOLUTION_LADDER=

# ===========================================
# API Gateway
# ===========================================
GATEWAY_PORT=8080
GATEWAY_RATE_LIMIT_REPLENISH_RATE=100
GATEWAY_RATE_LIMIT_BURST_CAPACITY=200

# ===========================================
# Service Ports (internal Docker network)
# ===========================================
AUTH_SERVICE_PORT=8081
USER_SERVICE_PORT=8082
VIDEO_SERVICE_PORT=8083
UPLOAD_SERVICE_PORT=8084
SEARCH_SERVICE_PORT=8085
ENGAGEMENT_SERVICE_PORT=8086
SUBSCRIPTION_SERVICE_PORT=8087
PLAYLIST_SERVICE_PORT=8088
NOTIFICATION_SERVICE_PORT=8089
ANALYTICS_SERVICE_PORT=8090
MODERATION_SERVICE_PORT=8091
LIVE_TV_SERVICE_PORT=8092

# ===========================================
# Frontend (Web)
# ===========================================
WEB_PORT=3000
WEB_API_URL=http://localhost:8080/api/v1

# ===========================================
# Mobile (React Native / Expo)
# ===========================================
MOBILE_API_URL=http://localhost:8080/api/v1
EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1

# ===========================================
# CORS Origins
# ===========================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,exp://localhost:8081

# ===========================================
# Email (Future - for notifications)
# ===========================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@videoplatform.local

# ===========================================
# Monitoring & Observability
# ===========================================
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=false
JAEGER_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ===========================================
# Feature Flags
# ===========================================
FEATURE_ML_RECOMMENDATIONS=false
FEATURE_LIVE_STREAMING=true
FEATURE_LIVE_TV=true
FEATURE_PAYMENTS=false
FEATURE_ADVERTISEMENTS=false
FEATURE_DRM=false

# ===========================================
# Live TV (IPTV-org)
# ===========================================
LIVETV_IPTV_ORG_CHANNELS_URL=https://raw.githubusercontent.com/iptv-org/iptv/master/channels.json
LIVETV_IPTV_ORG_CATEGORIES_URL=https://raw.githubusercontent.com/iptv-org/iptv/master/categories.json
LIVETV_IPTV_ORG_COUNTRIES_URL=https://raw.githubusercontent.com/iptv-org/iptv/master/countries.json
LIVETV_IPTV_ORG_EPG_URL=https://raw.githubusercontent.com/iptv-org/epg/master/epg.xml.gz
LIVETV_SYNC_ENABLED=true
LIVETV_SYNC_INTERVAL_HOURS=6
LIVETV_HEALTH_CHECK_ENABLED=true
LIVETV_HEALTH_CHECK_INTERVAL_MINUTES=30
LIVETV_HEALTH_CHECK_TIMEOUT_SECONDS=10
LIVETV_HEALTH_CHECK_MAX_CONCURRENT=50

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_PATH=/var/log/video-platform

# ===========================================
# Admin User (created on first startup)
# ===========================================
ADMIN_EMAIL=admin@videoplatform.local
ADMIN_PASSWORD=admin_dev_password_change_me
ADMIN_USERNAME=admin
# UAT PostgreSQL (used by docker-compose.yml + docker-compose.uat.yml)
UAT_POSTGRES_DB=video_platform_uat
UAT_POSTGRES_USER=platform_uat
UAT_POSTGRES_PASSWORD=platform_uat_password
